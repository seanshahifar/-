# Copy this file to .env and fill in what you need. .env is git-ignored.

# --- Exchange API keys (only needed for LIVE trading) -----------------------
# Create keys on your exchange with "trade" + "view" permissions only.
# NEVER enable withdrawal permission for a trading bot key.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# Some exchanges (e.g. OKX, KuCoin) also need a passphrase:
EXCHANGE_API_PASSWORD=

# Live trading is refused unless this is set to exactly I_ACCEPT_THE_RISK
# (in addition to mode = "live" in config.toml).
BTCAGENT_LIVE_CONFIRM=

# --- News analysis with Claude (optional) -----------------------------------
# When set, headlines are scored by Claude; otherwise a built-in lexicon is used.
ANTHROPIC_API_KEY=

# --- Dashboard --------------------------------------------------------------
# Required if you bind the dashboard to anything other than localhost.
DASHBOARD_TOKEN=
